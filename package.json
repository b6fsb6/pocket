{
  "name": "pocket-tests",
  "private": true,
  "description": "Tests for Pocket. The app itself is the single file index.html.",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:core": "node --test tests/core.test.js tests/libraries.test.js tests/style.test.js",
    "test:browser": "node --test tests/browser.test.js tests/a11y.test.js",
    "style:baseline": "node tests/style.js --update"
  },
  "devDependencies": {
    "axe-core": "^4.14.0",
    "playwright": "^1.48.0"
  }
}
